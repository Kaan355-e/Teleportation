-- Heartbeat Loop
spamHeartbeatConnection = RunService.Heartbeat:Connect(function()
    if spamActive and selectedSpamPlayer then
        performTeleport(selectedSpamPlayer, SPAM_OFFSET)
    elseif cycleActive and currentCycleTarget then
        performTeleport(currentCycleTarget, SPAM_OFFSET)
    end
end)

-- Sıralı Döngü (Cycle)
task.spawn(function()
    local currentIndex = 1
    while screenGui and screenGui.Parent do
        if cycleActive then
            local players = Players:GetPlayers()
            local validPlayers = {}
            for i = 1, #players do
                if players[i] ~= LocalPlayer then table.insert(validPlayers, players[i]) end
            end

            if #validPlayers > 0 then
                if currentIndex > #validPlayers then currentIndex = 1 end
                local target = validPlayers[currentIndex]
                
                local targetChar = target.Character
                local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")

                if targetRoot and targetHum and targetHum.Health > 0 then
                    currentCycleTarget = target
                    local elapsed = 0
                    while elapsed < 5 and cycleActive and screenGui and screenGui.Parent do
                        if not target:IsDescendantOf(Players) or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
                            break
                        end
                        task.wait(0.2)
                        elapsed = elapsed + 0.2
                    end
                    currentIndex = currentIndex + 1
                else
                    currentIndex = currentIndex + 1
                    task.wait(0.1)
                end
            else
                currentCycleTarget = nil
                task.wait(1)
            end
        else
            currentCycleTarget = nil
            currentIndex = 1
            task.wait(0.2)
        end
    end
end)

-- Bağlantı Dinleyicileri
table.insert(connections, Players.PlayerAdded:Connect(updateAllLists))
table.insert(connections, Players.PlayerRemoving:Connect(function(leavingPlayer)
    if selectedNormalPlayer == leavingPlayer then selectedNormalPlayer = nil end
    if selectedSpamPlayer == leavingPlayer then
        selectedSpamPlayer = nil
        spamActive = false
        updateSpamToggleUI()
    end
    if currentCycleTarget == leavingPlayer then currentCycleTarget = nil end
    updateAllLists()
end))
table.insert(connections, screenGui.Destroying:Connect(destroyGui))

updateAllLists()

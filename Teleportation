-- Liste Güncelleme
local function updatePlayerList(frame, selectedVar, buttonTable, clearConnFunc, isSpamList)
    if not screenGui or not screenGui.Parent or not frame then return end
    clearConnFunc()

    if selectedVar and (not selectedVar:IsDescendantOf(Players) or selectedVar == LocalPlayer) then
        selectedVar = nil
    end

    for _, child in ipairs(frame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    table.clear(buttonTable)

    local players = Players:GetPlayers()
    if not isSpamList then
        local count = #players > 0 and (#players - 1) or 0
        tabNormalBtn.Text = "Normal (" .. count .. ")"
    end

    for _, player in ipairs(players) do
        if player ~= LocalPlayer then
            local pBtn = Instance.new("TextButton", frame)
            pBtn.Size = UDim2.new(1, -6, 0, 25)
            pBtn.Text = "  " .. player.DisplayName .. " (@" .. player.Name .. ")"
            pBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            pBtn.BackgroundColor3 = (selectedVar == player) and Color3.fromRGB(60, 90, 120) or Color3.fromRGB(40, 40, 40)
            pBtn.BackgroundTransparency = (selectedVar == player) and 0 or 0.6
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            pBtn.Font = Enum.Font.SourceSans
            pBtn.TextSize = 14
            pBtn.BorderSizePixel = 0

            bindClick(pBtn, function()
                if isSpamList then
                    selectedSpamPlayer = player
                else
                    selectedNormalPlayer = player
                end
                for p, btn in pairs(buttonTable) do
                    local isSelected = (p == player)
                    btn.BackgroundColor3 = isSelected and Color3.fromRGB(60, 90, 120) or Color3.fromRGB(40, 40, 40)
                    btn.BackgroundTransparency = isSelected and 0 or 0.6
                end
            end, isSpamList and "spam" or "list")

            buttonTable[player] = pBtn
        end
    end
end

local function updateAllLists()
    task.defer(function()
        updatePlayerList(listFrame, selectedNormalPlayer, playerButtons, clearListConnections, false)
        updatePlayerList(spamListFrame, selectedSpamPlayer, spamButtons, clearSpamListConnections, true)
    end)
end

-- Işınlanma Fonksiyonu
local function performTeleport(targetPlayer, offsetCFrame)
    if not targetPlayer or targetPlayer == LocalPlayer or not targetPlayer:IsDescendantOf(Players) then return false end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHum or myHum.Health <= 0 then return false end

    local targetChar = targetPlayer.Character
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")

    if targetRoot and targetHum and targetHum.Health > 0 then
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
        myRoot.CFrame = targetRoot.CFrame * offsetCFrame
        return true
    end
    return false
end

bindClick(tpButton, function()
    if selectedNormalPlayer then
        if not performTeleport(selectedNormalPlayer, NORMAL_OFFSET) then
            selectedNormalPlayer = nil
            updateAllLists()
        end
    end
end, false)


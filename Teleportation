-- Bellek Temizlik Fonksiyonları
local function clearListConnections()
    for i = 1, #listConnections do
        local conn = listConnections[i]
        if conn and conn.Connected then conn:Disconnect() end
    end
    table.clear(listConnections)
end

local function clearSpamListConnections()
    for i = 1, #spamListConnections do
        local conn = spamListConnections[i]
        if conn and conn.Connected then conn:Disconnect() end
    end
    table.clear(spamListConnections)
end

local function destroyGui()
    if isDestroying then return end
    isDestroying = true

    if spamHeartbeatConnection then
        spamHeartbeatConnection:Disconnect()
        spamHeartbeatConnection = nil
    end

    clearListConnections()
    clearSpamListConnections()
    for i = 1, #connections do
        local conn = connections[i]
        if conn and conn.Connected then conn:Disconnect() end
    end
    table.clear(connections)

    if screenGui and screenGui.Parent then
        screenGui:Destroy()
    end
end

-- Akıllı Sürükleme Mantığı
local function makeSmartDraggable(triggerObject, targetObject, onClick)
    targetObject = targetObject or triggerObject
    local dragging = false
    local dragStart = Vector3.zero
    local startPos = UDim2.new()
    local hasMoved = false

    local connBegan = triggerObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            hasMoved = false
            dragStart = input.Position
            startPos = targetObject.Position

            local connEnded
            connEnded = UserInputService.InputEnded:Connect(function(endInput)
                if endInput.UserInputType == input.UserInputType then
                    dragging = false
                    if connEnded then connEnded:Disconnect() end
                    if not hasMoved and onClick then
                        onClick()
                    end
                end
            end)
            table.insert(connections, connEnded)
        end
    end)
    table.insert(connections, connBegan)

    local connChanged = UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 5 then
                hasMoved = true
            end
            targetObject.Position = UDim2.new(
                startPos.X.Scale, 
                startPos.X.Offset + delta.X, 
                startPos.Y.Scale, 
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    table.insert(connections, connChanged)
end

-- Güvenli Tıklama Bağlayıcı
local function bindClick(button, callback, targetTable)
    local startPos = Vector2.zero
    local connBegan = button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            startPos = Vector2.new(input.Position.X, input.Position.Y)
        end
    end)

    local connEnded = button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local endPos = Vector2.new(input.Position.X, input.Position.Y)
            if (endPos - startPos).Magnitude < 6 then
                callback()
            end
        end
    end)

    if targetTable == "list" then
        table.insert(listConnections, connBegan)
        table.insert(listConnections, connEnded)
    elseif targetTable == "spam" then
        table.insert(spamListConnections, connBegan)
        table.insert(spamListConnections, connEnded)
    else
        table.insert(connections, connBegan)
        table.insert(connections, connEnded)
    end
end


local function updateNormalPlayerList()
    if not screenGui or not screenGui.Parent or not listFrame then return end
    clearListConnections()

    if selectedNormalPlayer and (not selectedNormalPlayer:IsDescendantOf(Players) or selectedNormalPlayer == LocalPlayer) then
        selectedNormalPlayer = nil
    end

    local children = listFrame:GetChildren()
    for i = 1, #children do
        if children[i]:IsA("TextButton") then children[i]:Destroy() end
    end
    table.clear(playerButtons)

    local players = Players:GetPlayers()
    local otherPlayersCount = #players > 0 and (#players - 1) or 0
    tabNormalBtn.Text = "Normal (" .. otherPlayersCount .. ")"

    for i = 1, #players do
        local player = players[i]
        if player ~= LocalPlayer then
            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, -6, 0, 25)
            pBtn.Text = "  " .. player.DisplayName .. " (@" .. player.Name .. ")"
            pBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            pBtn.BackgroundColor3 = (selectedNormalPlayer == player) and Color3.fromRGB(60, 90, 120) or Color3.fromRGB(40, 40, 40)
            pBtn.BackgroundTransparency = (selectedNormalPlayer == player) and 0 or 0.6
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            pBtn.Font = Enum.Font.SourceSans
            pBtn.TextSize = 14
            pBtn.BorderSizePixel = 0
            pBtn.Parent = listFrame

            bindClick(pBtn, function()
                selectedNormalPlayer = player
                for p, btn in pairs(playerButtons) do
                    if p == selectedNormalPlayer then
                        btn.BackgroundColor3 = Color3.fromRGB(60, 90, 120)
                        btn.BackgroundTransparency = 0
                    else
                        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                        btn.BackgroundTransparency = 0.6
                    end
                end
            end, "list")

            playerButtons[player] = pBtn
        end
    end
end

local function updateSpamPlayerList()
    if not screenGui or not screenGui.Parent or not spamListFrame then return end
    clearSpamListConnections()

    if selectedSpamPlayer and (not selectedSpamPlayer:IsDescendantOf(Players) or selectedSpamPlayer == LocalPlayer) then
        selectedSpamPlayer = nil
        spamActive = false
    end

    local children = spamListFrame:GetChildren()
    for i = 1, #children do
        if children[i]:IsA("TextButton") then children[i]:Destroy() end
    end
    table.clear(spamButtons)

    local players = Players:GetPlayers()
    for i = 1, #players do
        local player = players[i]
        if player ~= LocalPlayer then
            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, -6, 0, 25)
            pBtn.Text = "  " .. player.DisplayName .. " (@" .. player.Name .. ")"
            pBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            pBtn.BackgroundColor3 = (selectedSpamPlayer == player) and Color3.fromRGB(60, 90, 120) or Color3.fromRGB(40, 40, 40)
            pBtn.BackgroundTransparency = (selectedSpamPlayer == player) and 0 or 0.6
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            pBtn.Font = Enum.Font.SourceSans
            pBtn.TextSize = 14
            pBtn.BorderSizePixel = 0
            pBtn.Parent = spamListFrame

            bindClick(pBtn, function()
                selectedSpamPlayer = player
                for p, btn in pairs(spamButtons) do
                    if p == selectedSpamPlayer then
                        btn.BackgroundColor3 = Color3.fromRGB(60, 90, 120)
                        btn.BackgroundTransparency = 0
                    else
                        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                        btn.BackgroundTransparency = 0.6
                    end
                end
            end, "spam")

            spamButtons[player] = pBtn
        end
    end
end

local function updateAllLists()
    task.defer(function()
        updateNormalPlayerList()
        updateSpamPlayerList()
    end)
end

-- Normal Işınlanma
local function teleportToPlayer(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then return end
    if not targetPlayer:IsDescendantOf(Players) then
        selectedNormalPlayer = nil
        updateNormalPlayerList()
        return
    end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local targetChar = targetPlayer.Character
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

    if targetRoot then
        myRoot.CFrame = targetRoot.CFrame * OFFSET_CFRAME
    else
        selectedNormalPlayer = nil
        updateNormalPlayerList()
    end
end

bindClick(tpButton, function()
    if selectedNormalPlayer then
        teleportToPlayer(selectedNormalPlayer)
    end
end, false)

-- Spam Toggle Butonu
local function updateSpamToggleUI()
    if spamActive then
        spamToggleButton.Text = "Spam Işınlanma: AÇIK"
        spamToggleButton.BackgroundColor3 = Color3.fromRGB(40, 180, 60)
    else
        spamToggleButton.Text = "Spam Işınlanma: KAPALI"
        spamToggleButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    end
end

bindClick(spamToggleButton, function()
    if not selectedSpamPlayer then
        spamToggleButton.Text = "Önce Oyuncu Seç!"
        task.delay(1, function() updateSpamToggleUI() end)
        return
    end
    spamActive = not spamActive
    updateSpamToggleUI()
end, false)

-- Spam Loop
spamHeartbeatConnection = RunService.Heartbeat:Connect(function()
    if spamActive and selectedSpamPlayer then
        if selectedSpamPlayer:IsDescendantOf(Players) then
            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            
            local targetChar = selectedSpamPlayer.Character
            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
            local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")

            if myRoot and targetRoot and myHum and myHum.Health > 0 and targetHum and targetHum.Health > 0 then
                myRoot.CFrame = targetRoot.CFrame * OFFSET_CFRAME
            end
        else
            selectedSpamPlayer = nil
            spamActive = false
            updateSpamToggleUI()
            updateSpamPlayerList()
        end
    end
end)

